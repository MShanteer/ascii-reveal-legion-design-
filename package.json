{
  "name": "ascii-reveal-legion",
  "version": "0.4.0-legion.1",
  "description": "The Legion design system's loading and reveal engine: terminal-style ASCII skeletons, loaders and reveals for React 19 and Next.js 16. A fork of ascii-reveal.",
  "license": "MIT",
  "author": "Quan Hoang",
  "contributors": [
    {
      "name": "Moose Shanteer",
      "url": "https://github.com/MShanteer"
    }
  ],
  "homepage": "https://github.com/MShanteer/ascii-reveal-legion-design-#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MShanteer/ascii-reveal-legion-design-.git"
  },
  "bugs": {
    "url": "https://github.com/MShanteer/ascii-reveal-legion-design-/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./legion.css": "./dist/legion.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "react",
    "nextjs",
    "ascii",
    "loading",
    "reveal",
    "animation",
    "skeleton",
    "text-scramble",
    "terminal",
    "design-system",
    "legion"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsup && node scripts/copy-css.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "demo": "npm --prefix demo run dev",
    "prepublishOnly": "npm run build",
    "test:setup": "npm install --prefix test/react18",
    "test": "node --test test/quality.test.mjs test/ssr.test.mjs && node test/smoke.mjs && node test/guardrails.mjs && node test/legion.mjs && node test/hydrate.mjs"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.27.7",
    "playwright": "^1.56.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
